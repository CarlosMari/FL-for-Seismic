{
  "dataset": "cifar10",
  "data_root": "datasets",
  "num_clients": 20,
  "split": "noniid",
  "partition_alpha": 0.1,
  "num_rounds": 100,
  "local_epochs": 5,
  "batch_size": 50,
  "lr": 0.01,
  "weight_decay": 0.0001,
  "num_classes": 10,
  "sample_ratio": 0.1,
  "seed": 42,
  "algorithm": "fedkper",
  "agg_strategy": "fedkper",
  "fedkper_diversity": "infer",
  "optimizer": "sgd",
  "momentum": 0.9,
  "local_test_ratio": 0.2,
  "lambda_cap": 10.0,
  "grad_clip": 5.0,
  "device": "cpu"
}
