{
  "dataset": "seismic",
  "data_root": "datasets",
  "multisurvey": true,
  "train_seismic": "datasets/seismic/data/train/train_seismic.npy",
  "train_labels": "datasets/seismic/data/train/train_labels.npy",
  "survey_b_seismic": "datasets/parihaka/parihaka_data_train_rot90.npz",
  "survey_b_labels": "datasets/parihaka/parihaka_labels_train_rot90.npz",
  "survey_b_offset": 6,
