{
    "data_setups":{
        "date": "02-02-26",
        "root": "./datasets/seismic",
        "base_folder": "./results/",
        "dataset_name": "seismic",
        "batch_size": 20,
        "n_clients": 50,
        "partition": {
            "method": "iid",
            "shard_per_user": 2,
            "alpha": 0.1,
            "use_val": false
        },
        "local_setups": {
            "eval_mode": "both",
            "dynamic_ratio": false,
            "consistency": false,
            "shift_type": "gaussian_noise",
            "in_order": true
        }
    },
    "train_setups":{
        "algo": {
            "name": "fedseismic",
            "params": {"beta": 0.5}
        },
        "scenario": {
            "n_rounds": 20,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model":{
            "name": "seismic",
            "params": {}
        },
        "optimizer":{
            "params": {"lr": 0.01, "momentum":0.9, "weight_decay": 1e-5}
        },
        "scheduler":{
            "enabled": true,
            "name": "step",
            "params": {"gamma":0.99, "step_size": 1}
        },
        "seed": 1
    },
    "wandb_setups":{
        "project": "FL-Seismic",
        "group": "fedseismic",
        "name": "fedseismic_baseline"
    }
}
